+
+int SDL_iPhoneGetWindowSafeAreaInsets(SDL_Window *window,
+                                      float *left, float *top,
+                                      float *right, float *bottom,
+                                      float *viewWidth, float *viewHeight)
+{
+    if (!window || !window->driverdata) {
+        return SDL_SetError("Invalid window");
+    }
+
+    @autoreleasepool {
+        SDL_WindowData *data = (__bridge SDL_WindowData *)window->driverdata;
+        UIView *view = data.viewcontroller.view;
+        CGSize size = view.bounds.size;
+        UIEdgeInsets insets = view.safeAreaInsets;
+
+        if (left) {
+            *left = size.width > 0.0 ? (float)(insets.left / size.width) : 0.0f;
+        }
+        if (top) {
+            *top = size.height > 0.0 ? (float)(insets.top / size.height) : 0.0f;
+        }
+        if (right) {
+            *right = size.width > 0.0 ? (float)(insets.right / size.width) : 0.0f;
+        }
+        if (bottom) {
+            *bottom = size.height > 0.0 ? (float)(insets.bottom / size.height) : 0.0f;
+        }
+        if (viewWidth) {
+            *viewWidth = (float)size.width;
+        }
+        if (viewHeight) {
+            *viewHeight = (float)size.height;
+        }
+    }
+
+    return 0;
+}
 
